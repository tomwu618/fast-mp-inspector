{
  "name": "fast-mp-inspector",
  "version": "1.1.0",
  "description": "4-layer zero-click E2E, MVVM data, WXSS layout/occlusion, and live wx.request verification skill + MCP stdio server for WeChat Mini Programs (Native, uni-app, Taro).",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "inspect-mp": "./scripts/inspect-mp.mjs",
    "check-mp-bundle": "./scripts/check-mp-bundle.mjs",
    "fast-mp-mcp": "./mcp/server.mjs"
  },
  "scripts": {
    "inspect": "node ./scripts/inspect-mp.mjs",
    "check-bundle": "node ./scripts/check-mp-bundle.mjs",
    "mcp": "node ./mcp/server.mjs",
    "test": "node ./tests/self-test.mjs && node ./tests/verify-mcp.mjs",
    "verify-mcp": "node ./tests/verify-mcp.mjs"
  },
  "keywords": [
    "agent-skill",
    "mcp",
    "mcp-server",
    "openmausbot",
    "claude-code",
    "antigravity",
